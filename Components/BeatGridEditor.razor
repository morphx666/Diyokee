@using Diyokee
@using static Diyokee.DFile

<div class="beat-grid-editor">
    <div class="header">
        <div class="button-3d @(Editing ? "active" : "")" @onclick="ToggleEditing">
            <i class="fa-solid fa-ruler-horizontal"></i> Grid
        </div>
        <div class="button-3d @(Warped ? "active" : "")" @onclick="ToggleWarped" title="Show the track stretched onto a uniform grid">
            <i class="fa-solid fa-arrows-left-right-to-line"></i> Straighten
        </div>
        <div class="spacer"></div>
        <div class="drift">@DriftSummary</div>
    </div>

    @if(Editing) {
        <div class="actions">
            <div class="button-3d" @onclick="AddAtPlayhead" title="Drop an anchor at the playhead"><i class="fa-solid fa-plus"></i></div>
            <div class="nudges">
                <div class="button-3d" @onclick="() => Nudge(-0.010)">−10</div>
                <div class="button-3d" @onclick="() => Nudge(-0.001)">−1</div>
                <span>ms</span>
                <div class="button-3d" @onclick="() => Nudge(+0.001)">+1</div>
                <div class="button-3d" @onclick="() => Nudge(+0.010)">+10</div>
            </div>
            <div class="spacer"></div>
            <div class="button-3d danger" @onclick="ResetGrid" title="Delete every anchor and fall back to BPM + downbeat">Reset</div>
        </div>

        <div class="anchors scroller">
            @if(Anchors.Count == 0) {
                <div class="empty">No anchors yet — this track uses its BPM and downbeat. Drop one at the playhead to start.</div>
            }
            @foreach(var item in Anchors.Select((a, i) => (a, i))) {
                <div class="anchor @(item.i == Selected ? "selected" : "")" @onclick="() => Select(item.i)">
                    <div class="cell mono">@DFile.FormatTime(item.a.Position, true)</div>
                    <div class="cell bpm @TintClass(item.a.BPM)">@item.a.BPM.ToString("0.00")</div>
                    <div class="cell">
                        <input type="checkbox" checked="@item.a.IsDownbeat" @onchange="e => SetDownbeat(item.i, e)" title="Restart the bar count here" />
                    </div>
                    <div class="cell right">
                        <button class="anchor-button" @onclick="() => SetFromPlayhead(item.i)" @onclick:stopPropagation="true" title="Move to the playhead">
                            <i class="fa-solid fa-arrow-turn-down"></i>
                        </button>
                        <button class="anchor-button" @onclick="() => Delete(item.i)" @onclick:stopPropagation="true" title="Delete">
                            <i class="fa-solid fa-circle-xmark"></i>
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="hint">
            Drag an anchor's flag to stretch the section before it. The dotted lines show where the
            beats were when you started.
        </div>
    }
</div>

@code {
    [Parameter]
    public Player Player { get; set; } = default!;

    [Parameter]
    public DFile File { get; set; } = default!;

    [Parameter]
    public bool Editing { get; set; }

    [Parameter]
    public EventCallback<bool> EditingChanged { get; set; }

    [Parameter]
    public bool Warped { get; set; }

    [Parameter]
    public EventCallback<bool> WarpedChanged { get; set; }

    [Parameter]
    public int Selected { get; set; } = -1;

    [Parameter]
    public EventCallback<int> SelectedChanged { get; set; }

    private List<BeatGridMarker> Anchors => File?.BeatGridMarkers ?? [];

    // How far the track has to be pushed or held back, as a percentage of its nominal tempo. This
    // is the number the eventual playback warp acts on, so showing it here is the honest readout
    // of what gridding this track is actually asking for.
    private string DriftSummary {
        get {
            if(File == null || Anchors.Count == 0) return "no anchors";
            if(!(File.BPM > 0)) return "no BPM";

            double worst = Anchors.Max(a => Math.Abs(a.BPM / File.BPM - 1.0));
            if(worst < 0.0005) return "on grid";
            return $"±{worst * 100:0.00}% drift";
        }
    }

    private string TintClass(double bpm) {
        if(File == null || !(File.BPM > 0) || !(bpm > 0)) return "";
        double ratio = bpm / File.BPM;
        if(ratio < 0.999) return "slow";
        if(ratio > 1.001) return "fast";
        return "";
    }

    private async Task ToggleEditing() {
        Editing = !Editing;

        // Dropping out of edit mode hands the platter back, so nothing is left half-grabbed.
        if(!Editing) await Select(-1);
        await EditingChanged.InvokeAsync(Editing);
    }

    private async Task ToggleWarped() {
        Warped = !Warped;
        await WarpedChanged.InvokeAsync(Warped);
        await Player.RefreshBeatGrid();
    }

    private async Task Select(int index) {
        Selected = index;
        await SelectedChanged.InvokeAsync(index);
    }

    // A new anchor takes the tempo already in force where it lands, so dropping one changes
    // nothing until it is dragged. You place it, then bend it - never both at once.
    private async Task AddAtPlayhead() {
        double at = Player.WaveformHeadToSeconds(Player.PlaybackHead);
        double bpm = Player.Grid.TempoAt(at);
        if(!(bpm > 0)) bpm = File.BPM;

        // Seed from the legacy pair, so the first anchor a user drops does not silently discard
        // the downbeat the analyser found.
        if(Anchors.Count == 0 && File.DownbeatAt >= 0 && Math.Abs(File.DownbeatAt - at) > 0.001) {
            BeatGrid.Insert(Anchors, File.DownbeatAt, File.BPM, true);
        }

        int index = BeatGrid.Insert(Anchors, at, bpm, false);
        await Select(index);
        await Player.RefreshBeatGrid();
    }

    private async Task Delete(int index) {
        BeatGrid.Delete(Anchors, index);
        if(Selected >= Anchors.Count) await Select(Anchors.Count - 1);
        await Player.RefreshBeatGrid();
    }

    private async Task SetFromPlayhead(int index) {
        var bend = BeatGrid.BeginBend(Anchors, index);
        BeatGrid.ApplyBend(Anchors, bend, Player.WaveformHeadToSeconds(Player.PlaybackHead));
        await Select(index);
        await Player.RefreshBeatGrid();
    }

    private async Task SetDownbeat(int index, ChangeEventArgs e) {
        Anchors[index].IsDownbeat = e.Value is bool b && b;
        await Player.RefreshBeatGrid();
    }

    // The precise instrument. One pixel of drag is 10 ms at the default zoom and the waveform's
    // own resolution is 50 ms, so the drag is the coarse control and this is the accurate one.
    private async Task Nudge(double seconds) {
        if(Selected < 0 || Selected >= Anchors.Count) return;

        var bend = BeatGrid.BeginBend(Anchors, Selected);
        BeatGrid.ApplyBend(Anchors, bend, Anchors[Selected].Position + seconds);
        await Player.RefreshBeatGrid();
    }

    private async Task ResetGrid() {
        Anchors.Clear();
        await Select(-1);
        await Player.RefreshBeatGrid();
    }
}
