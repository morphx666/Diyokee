@using Diyokee
@using Diyokee.MediaProviders
@using Un4seen.Bass.AddOn.Midi
@using static Diyokee.Settings
@inject IJSRuntime JS
@inject SessionState session
@implements IDisposable

@page "/"

<PageTitle>Diyokee</PageTitle>

<div class="main-console"
     tabindex="0"
     @onkeydown="HandleKeyDown"
     @onkeyup="HandleKeyUp"
     @onfocusout="HandleFocusOut"
     @onkeydown:preventDefault="false"
     @onkeyup:preventDefault="false">
     <CascadingValue Value="@mouseState">
        <div class="players" @ref="playersPanel">
            <div class="player">
                <Player
                    Settings="Program.Settings.Playback.Players[0]"
                    File="@player1File"
                    RequestedFileCue="() => LoadSelectedFile(player1)"
                    OtherPlayer="@player2"
                    @ref="player1" />
            </div>

            <div class="global-controls">
                <Knob Name="GAIN" @ref="mainGain" RangeFromCenter="false" ValueChanged="ApplyMainGain" />
                <div class="button-thin" @onclick="OpenSettingsDialog"><i class="fa-solid fa-gear"></i></div>
            </div>

            <div class="player">
                <Player
                    Settings="Program.Settings.Playback.Players[1]"
                    File="@player2File"
                    RequestedFileCue="() => LoadSelectedFile(player2)"
                    OtherPlayer="@player1"
                    @ref="player2" />
            </div>
        </div>

        @if(Program.Settings.Playback.BeatmatchingDisplay) {
            <div class="beatmatching">
                <BeatMatching
                Player1="player1"
                Player2="player2"
                />
            </div>
        }

        <div class="mixer" @ref="mixerPanel">
            <div class="crossfade-controls">
                <div class="button-3d" @onclick="() => HandleAutoCrossFade(-1)"><i class="fa-solid fa-caret-left"></i></div>
                <Fader Orientation="Fader.Orientations.Horizontal" ValueChanged="ApplyCrossfaderVolume" DefaultValue="0.5" @ref="crossFader" />
                <div class="button-3d" @onclick="() => HandleAutoCrossFade(+1)"><i class="fa-solid fa-caret-right"></i></div>
            </div>
            <div class="monitor-controls">
                <Knob Name="Volume" @ref="monitorVolume" RangeFromCenter="false" Enabled="hasMonitorDevice" ValueChanged="ApplyMonitorVolume" />
                <i class="fa-solid fa-volume-high"></i>
                <Knob Name="Mix" @ref="monitorMix" Enabled="hasMonitorDevice" ValueChanged="ApplyMonitorMix" />
                <i class="fa-solid fa-headphones-simple"></i>
            </div>
        </div>

        <PanelResize
            Orientation="PanelResize.Orientations.Vertical"
            ResizeElement="playersPanel"
            ElementsBetween="new() { mixerPanel }"
            Name="main-resize-vertical"
            OnResizeEnd="HandleDividerResize"
            Constrains="playersConstrains" />

        <div class="media">
            <div class="media-providers" @ref="mediaProviderPanel">
                <div class="tabs">
                    @foreach(IMediaProvider provider in mediaProviders) {
                        <div class="tab @(selectedMediaProvider == provider ? "selected" : "")"
                                @onclick="() => {
                                selectedMediaProvider = provider;
                                // FIXME: Hopefully we can find an easier way to do this...
                                selectedMediaProvider.InitialPath = Program.Settings.MediaProviders.Where(mp => mp.Name == provider.Name).First().InitialPath;
                                SelectedFolderChanged(string.Empty);
                                shouldRender = true;
                            }">
                        @provider.Name
                    </div>
                                        }
                </div>

                <div class="sources panel">
                    <MediaProviderContainer
                        Provider="@selectedMediaProvider"
                        SelectedFolderChanged="SelectedFolderChanged"
                        @ref="mediaProviderContainerUI" />
                </div>
            </div>

            <PanelResize
                Orientation="PanelResize.Orientations.Horizontal"
                ResizeElement="mediaProviderPanel"
                Name="main-resize-horizontal"
                OnResizeEnd="HandleDividerResize"
                Constrains="mediaProviderConstrains" />

            <Files
                Provider="@selectedMediaProvider"
                RelativePath="@selectedFolder"
                SelectedFileChanged="SelectedFileChanged"
                @ref="filesComponent" />
        </div>

        @if(showSettingsDialog) {
            <Settings
                OnSave="() => CloseSettingsDialog(true)"
                OnClose="() => CloseSettingsDialog(false)" />
        }
    </CascadingValue>
</div>

@code {
    private List<IMediaProvider> mediaProviders = new();
    private IMediaProvider? selectedMediaProvider;
    private string selectedFolder = "";

    private DFile? selectedFile = null;
    private DFile? player1File = null;
    private DFile? player2File = null;

    private Files? filesComponent;
    private MediaProviderContainer? mediaProviderContainerUI;

    private Player? player1;
    private Player? player2;
    private Fader? crossFader;

    private bool showSettingsDialog = false;
    private MouseState mouseState = new();

    private ElementReference playersPanel;
    private ElementReference mixerPanel;
    private Dictionary<PanelResize.ConstrainKeys, string> playersConstrains = new() { { PanelResize.ConstrainKeys.Min, "420" } };
    private ElementReference mediaProviderPanel;
    private Dictionary<PanelResize.ConstrainKeys, string> mediaProviderConstrains = new() { { PanelResize.ConstrainKeys.Min, "250" } };

    private Knob? monitorMix = null!;
    private Knob? monitorVolume = null!;
    private Knob? mainGain = null!;

    private bool shouldRender = true;
    private bool enableMidiEvents = true;

    private Dictionary<string, string> cssVariables = [];

    private void LoadSelectedFile(Player? player) {
        if(player!.IsPlaying && Program.Settings.Playback.LockOnPlay) return;

        if(player == player1) {
            player1File = selectedFile;
        } else if(player == player2) {
            player2File = selectedFile;
        }
        shouldRender = true;
    }

    private void SelectedFolderChanged(string folder) {
        if(selectedMediaProvider == null) return;

        Program.Settings.MediaProviders.ForEach(mp => {
            if(mp.Name == selectedMediaProvider.Name) {
                mp.InitialPath = selectedMediaProvider.RootPath == folder ? "" : folder;
            }
        });
        selectedFolder = folder;
        shouldRender = true;

        session.Set(nameof(selectedFolder), folder);
    }

    private void SelectedFileChanged(DFile file) {
        selectedFile = file;
        shouldRender = true;

        if(player1!.File?.Filename == file.Filename) player1File = selectedFile;
        if(player2!.File?.Filename == file.Filename) player2File = selectedFile;

        session.Set(nameof(selectedFile), file);
    }

    // Shift suppresses beat snapping while it is held. It used to be written only here, so
    // releasing it without pressing another key left SnapToBeatMarkers off for the rest of the
    // session; and focus moving into a text field in a dialog meant the release was never seen at
    // all. Both now clear it, and both clear it towards snapping being ON, which is the state a
    // user who is not holding anything expects.
    private void HandleKeyUp(KeyboardEventArgs e) {
        mouseState.ShiftDown = e.ShiftKey;
    }

    private void HandleFocusOut() {
        mouseState.ShiftDown = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) {
        mouseState.ShiftDown = e.ShiftKey;
        if(e.ShiftKey && e.CtrlKey) {
            switch(e.Code) {
                case "KeyA":
                    player1File = selectedFile;
                    shouldRender = true;
                    break;
                case "KeyB":
                    player2File = selectedFile;
                    shouldRender = true;
                    break;
                case "KeyS":
                    await OpenSettingsDialog();
                    break;
            }
        }
    }

    private async Task OpenSettingsDialog() {
        enableMidiEvents = false;
        showSettingsDialog = true;

        shouldRender = true;
        await InvokeAsync(StateHasChanged);
    }

    private void HandleDividerResize((string name, double value) args) {
        if(Program.Settings.UIElements.ContainsKey(args.name)) {
            Program.Settings.UIElements[args.name] = args.value.ToString();
        } else {
            Program.Settings.UIElements.Add(args.name, args.value.ToString());
        }
    }

    private void ApplyMonitorVolume(double value) {
        monitorVolume?.SetValue(value);
        player1?.SetMonitorVolume(value);
        player2?.SetMonitorVolume(value);
    }

    private void ApplyMonitorMix(double value) {
        monitorMix?.SetValue(value);
        player1?.SetMonitorMix(value);
        player2?.SetMonitorMix(value);
    }

    private void ApplyMainGain(double value) {
        mainGain?.SetValue(value);
        value *= 2; // 0-1 to 0-2 range
        player1?.SetGain((float)value);
        player2?.SetGain((float)value);
    }

    private CancellationTokenSource? cancellationTokenSource = null;
    private Task? crossfadeTask = null;
    private void HandleAutoCrossFade(int direction) {
        if(crossFader == null) return;

        if(cancellationTokenSource == null) {
            cancellationTokenSource = new CancellationTokenSource();
        } else {
            cancellationTokenSource.Cancel();
            crossfadeTask?.Wait();
            cancellationTokenSource.Dispose();
            cancellationTokenSource = new CancellationTokenSource();
        }

        int duration = 2; // seconds
        crossfadeTask = Task.Run(async () => {
            while(!cancellationTokenSource.IsCancellationRequested) {
                double value = crossFader.Value - direction / 100.0;
                if(value < 0 || value > 1) break;
                await crossFader.SetValue(value, true);
                await Task.Delay(10 * duration);
            }
        }, cancellationTokenSource.Token);
    }

    private void ApplyCrossfaderVolume(double value) {
        player1?.SetCrossFaderVolume(value >= 0.5 ? 1 : 2 * value);
        player2?.SetCrossFaderVolume(value <= 0.5 ? 1 : 2 * (1 - value));
    }

    private void SetMediaProviders() {
        this.mediaProviders.Clear();

        foreach(Diyokee.Settings.MediaProvider mp in Program.Settings.MediaProviders) {
            if(mp.Type == "local") {
                MediaProviderLocal nmp = new(mp.Name,
                                            string.IsNullOrEmpty(mp.RootDirectory)
                                                ? MediaProviderLocal.DefaultDirectory
                                                : mp.RootDirectory,
                                            mp.InitialPath);
                this.mediaProviders.Add(nmp);
            } else if(mp.Type == "dropbox") {
                string refreshToken = Diyokee.Secrets.Unprotect(mp.RefreshToken);
                if(string.IsNullOrEmpty(DropboxOAuth.AppKey) || string.IsNullOrEmpty(refreshToken)) continue;
                DropboxConnection conn = DropboxConnection.GetOrCreate(mp.Name, refreshToken, mp.RootDirectory);
                MediaProviderDropbox nmp = new(mp.Name, conn, mp.InitialPath);
                this.mediaProviders.Add(nmp);
            }
        }

        if(this.mediaProviders.Count == 0) {
            MediaProviderLocal nmp = new("default", MediaProviderLocal.DefaultDirectory);
            //throw new Exception("No valid media providers found");
        } else {
            selectedMediaProvider = this.mediaProviders[0];
        }
    }

    private async void CloseSettingsDialog(bool update) {
        if(update) {
            EqualizerProfile equalizerProfile = Program.Settings.EqualizerProfiles.FirstOrDefault(p => p.Name == Program.Settings.Playback.EqProfile) ?? Program.Settings.EqualizerProfiles[0];
            player1!.EqControls.EqProfile = equalizerProfile;
            player1!.SetTempoRange(Program.Settings.Playback.TempoRange);

            player2!.EqControls.EqProfile = equalizerProfile;
            player2!.SetTempoRange(Program.Settings.Playback.TempoRange);

            SetMediaProviders();

            await JS.InvokeVoidAsync("forceRefresh");
        }

        enableMidiEvents = true;
        showSettingsDialog = false;

        shouldRender = true;
        await InvokeAsync(StateHasChanged);
    }

    // Both knobs only ever feed the monitor path, so they are dead controls without a device to
    // send it to. The audio matrix can now take that device away while the console is on screen.
    private bool hasMonitorDevice => Program.Settings.Audio.MonitorDevice.Count > 0;

    protected override void OnInitialized() {
        base.OnInitialized();
        Player.AudioDevicesChanged += HandleAudioDevicesChanged;
    }

    public void Dispose() {
        Player.AudioDevicesChanged -= HandleAudioDevicesChanged;
        Program.MidiTools.OnMidiEvent -= HandleMidiEvent;
    }

    private void HandleAudioDevicesChanged() {
        shouldRender = true;
        InvokeAsync(StateHasChanged);
    }

    protected override bool ShouldRender() {
        if(shouldRender) {
            shouldRender = false;
            return true;
        }
        return false;
    }

    private bool IsPlaying => player1!.IsPlaying || player2!.IsPlaying;

    // The handler used to be an anonymous lambda subscribed here and never removed. MidiTools is
    // a process-wide static that outlives any circuit, so every reconnect and every extra browser
    // tab left another live handler on it and each MIDI event was processed once per handler -
    // decks toggling twice on one button press, and a trace that cannot be read. It is a named
    // method now so Dispose can take it back off.
    private bool midiNavigateFolders = true;
    private readonly KeyTools midiKeyTools = new();
    private readonly List<int> midiPressedKeys = [];

    private void MidiMonitor() {
        Program.MidiTools.OnMidiEvent += HandleMidiEvent;
        Program.MidiTools.Start();
    }

    // Where BASS put the 0-127 value of a continuous control for this event type.
    //
    // BASS_MIDI_ConvertEvents gives a dedicated event type to the handful of CCs that have one -
    // CC 7 becomes MIDI_EVENT_VOLUME, CC 11 MIDI_EVENT_EXPRESSION, CC 1 MIDI_EVENT_MODULATION -
    // and for those param holds the value outright. Every other CC arrives as MIDI_EVENT_CONTROL
    // with the value packed into the high byte and the controller number in the low one. Reading
    // param the wrong way for the event at hand does not misread the value slightly, it reads a
    // completely different number, so this is the only place that decides.
    private static int MidiValue(BASS_MIDI_EVENT midiEvent) {
        return midiEvent.eventtype == BASSMIDIEvent.MIDI_EVENT_CONTROL
                ? (midiEvent.param >> 8) & 0xFF
                : midiEvent.param;
    }

    // The deck mappings the Track Properties preview can honour. It is a MinimalMode player: a
    // waveform, a volume fader and the four transport buttons, and nothing else. There is no tempo
    // fader, no EQ, no filters and no loop panel, and several of the Player methods behind those
    // missing controls dereference them - UpdateSettings reads EqControls.EqProfile, SetTempo and
    // SyncBPMToOtherPlayer read faderTempo - so this is a whitelist of what the preview actually
    // has rather than a filtered copy of the deck switch below. Everything else is dropped, which
    // is the point: a mapping with nowhere to go here must not fall through to the live deck A.
    //
    // Each of these has a visible counterpart in the dialog, so the controller and the screen
    // agree about what just happened.
    private void HandlePreviewMidiEvent(Player preview, string propertyName, MidiControllerProfile.MidiMapping mapping, BASS_MIDI_EVENT midiEvent, int velocity) {
        // Anything that moves the playhead or lights a button asks the preview to re-render, since
        // nothing else is going to. The deck cases below get that from MainConsole's own render.
        void Transport(Action action) {
            action();
            _ = preview.Refresh();
        }

        // Play is passed false throughout: the preview has no OtherPlayer, so there is nothing to
        // drop in on and Play would take the plain path whatever it was handed.
        switch(propertyName) {
            case "PlayPause":
                if(velocity > 0) Transport(() => preview.Play(false));
                return;
            case "Stop":
                if(velocity > 0) Transport(() => preview.Stop(false));
                return;
            case "Cue":
                Transport(() => {
                    if(velocity > 0) preview.Play(false); else preview.Stop(true);
                });
                return;
            case "SnapToBeatMarker":
                if(velocity > 0) Transport(preview.SnapToClosestBeatMarker);
                return;
            case "Volume":
                double volume = MidiValue(midiEvent) / 127.0;
                InvokeAsync(() => preview.SetTrackVolume(volume));
                return;
            case "JogWheelForward":
                if(mapping.Velocity == velocity) Transport(preview.JogWheelForward);
                return;
            case "JogWheelBackward":
                if(mapping.Velocity == velocity) Transport(preview.JogWheelBackward);
                return;

            // Off the renderer, exactly as on the deck: the platter is a control path and the
            // whole reason it does not go through InvokeAsync is that it must not queue behind a
            // render. The waveform follows the audio on its own timer, so nothing is needed here.
            case "JogTouch":
                preview.JogTouchChanged(velocity > 0);
                return;
            case "JogWheel":
                if(mapping.Mode != MidiControllerProfile.MappingModes.Relative) return;

                preview.ScratchByTicks(
                    MidiControllerProfile.DecodeRelative(MidiValue(midiEvent), mapping.RelativeFormat),
                    mapping.TicksPerRevolution);
                return;
            case "JogBend":
                // A paused preview scrubs, which is what this is for while gridding. A playing one
                // would want to bend the tempo fader the deck version reaches for, and the preview
                // has none - JogBendByTicks banks the ticks and ApplyPendingBend drops them.
                if(mapping.Mode != MidiControllerProfile.MappingModes.Relative) return;

                preview.JogBendByTicks(
                    MidiControllerProfile.DecodeRelative(MidiValue(midiEvent), mapping.RelativeFormat),
                    mapping.TicksPerRevolution);
                return;
        }
    }

    private void HandleMidiEvent(string propertyName, string section, MidiControllerProfile.MidiMapping mapping, BASS_MIDI_EVENT midiEvent, double timestamp) {
        if(!enableMidiEvents) return;

        int velocity = (midiEvent.param >> 8) & 0xFF;

        if(section == "general") {
            switch(propertyName) {
                case "FoldersFilesToggle":
                    midiNavigateFolders = !midiNavigateFolders;
                    if(!midiNavigateFolders) {
                        InvokeAsync(filesComponent!.SelectDown);
                        InvokeAsync(filesComponent!.SelectUp);
                    }
                    return;
                case "ExpandFolder":
                    InvokeAsync(mediaProviderContainerUI!.FoldersUI!.ExpandSelectedFolder);
                    return;
                case "Crossfader":
                    // This read the whole param, which is right only for a crossfader on CC 11,
                    // arriving as MIDI_EVENT_EXPRESSION - which is what the XDJ-RR sends, so it
                    // worked there. The DDJ-SB3 sends CC 31, where param is (value << 8) | 31, and
                    // the arithmetic collapsed to two reachable positions: 1 - 31/127 = 0.76 with
                    // the fader at the very bottom, and a negative number that SetValue clamps to
                    // 0 for every other value. Hence a smooth fader behaving like a two-way switch.
                    double crossfaderValue = 1.0 - MidiValue(midiEvent) / 127.0;
                    InvokeAsync(() => crossFader!.SetValue(crossfaderValue, true));
                    return;
                case "BrowseUp":
                    if(mapping.Parameter != midiEvent.param) return;
                    if(midiNavigateFolders) {
                        InvokeAsync(mediaProviderContainerUI!.FoldersUI!.SelectUp);
                    } else {
                        InvokeAsync(filesComponent!.SelectUp);
                    }
                    return;
                case "BrowseDown":
                    if(mapping.Parameter != midiEvent.param) return;
                    if(midiNavigateFolders) {
                        InvokeAsync(mediaProviderContainerUI!.FoldersUI!.SelectDown);
                    } else {
                        InvokeAsync(filesComponent!.SelectDown);
                    }
                    return;
                case "Gain":
                    // The mirror of the crossfader bug, and reachable the same way: assuming the
                    // value is always in the high byte reads 0 for every event of a type that puts
                    // it in param, so a gain mapped to CC 11 would sit at zero and never move.
                    double gainValue = MidiValue(midiEvent) / 127.0;
                    InvokeAsync(() => mainGain!.SetValue(gainValue, true));
                    return;
            }
        }

        if(section.StartsWith("player")) {
            // Deck A's controls drive the Track Properties preview for as long as that dialog is
            // open. The dialog is modal, so the preview is the only deck the user can see or aim
            // at, and a platter that still moved the real deck A would be acting on something
            // hidden behind it. Deck B is deliberately left alone: it may well be what the room
            // is hearing, and nothing about editing a track's grid says to take it away.
            if(section == "player0" && filesComponent?.TrackPropertiesPlayer is Player preview) {
                HandlePreviewMidiEvent(preview, propertyName, mapping, midiEvent, velocity);
                return;
            }

            Player? targetPlayer = null;
            if(section == "player0") targetPlayer = player1;
            else if(section == "player1") targetPlayer = player2;
            if(targetPlayer == null) return;

            double value = MidiValue(midiEvent) / 127.0;

            var PlayerAction = (Action fcn) => {
                if(velocity > 0) {
                    fcn();
                    shouldRender = true;
                    InvokeAsync(StateHasChanged);
                }
            };

            switch(propertyName) {
                case "PlayPause":
                    if(velocity > 0) targetPlayer.Play(targetPlayer.SnapToBeatMarkers && Program.Settings.Playback.SyncPlayback);
                    return;
                case "Stop":
                    if(velocity > 0) targetPlayer.Stop(false);
                    return;
                case "Cue":
                    if(velocity > 0) {
                        targetPlayer.Play(targetPlayer.SnapToBeatMarkers && Program.Settings.Playback.SyncPlayback);
                    } else {
                        targetPlayer.Stop(true);
                    }
                    return;
                case "LoadSelectedFile":
                    PlayerAction(() => {
                        if(targetPlayer == player1) {
                            player1File = selectedFile;
                        } else if(targetPlayer == player2) {
                            player2File = selectedFile;
                        }
                        shouldRender = true;
                        if(!IsPlaying) InvokeAsync(StateHasChanged);
                    });
                    return;
                case "LoopJumpLockToggle":
                    PlayerAction(targetPlayer.ToggleLoopJumpSync);
                    return;
                case "LoopToggle":
                    PlayerAction(targetPlayer.ToggleLoop);
                    return;
                case "LoopSizeIncrease":
                    PlayerAction(targetPlayer.LoopSizeIncrease);
                    return;
                case "LoopSizeDecrease":
                    PlayerAction(targetPlayer.LoopSizeDecrease);
                    return;
                case "JumpSizeIncrease":
                    PlayerAction(targetPlayer.JumpSizeIncrease);
                    return;
                case "JumpSizeDecrease":
                    PlayerAction(targetPlayer.JumpSizeDecrease);
                    return;
                case "SnapToBeatMarker":
                    PlayerAction(targetPlayer.SnapToClosestBeatMarker);
                    return;
                case "Volume":
                    double volume = value;
                    InvokeAsync(() => targetPlayer.SetTrackVolume(volume));
                    return;
                case "EqHi":
                    InvokeAsync(() => {
                        targetPlayer.EqControls.ApplyEqHi(value);
                        targetPlayer.EqControls.UpdateKnobs();
                    });
                    return;
                case "EqMid":
                    InvokeAsync(() => {
                        targetPlayer.EqControls.ApplyEqMid(value);
                        targetPlayer.EqControls.UpdateKnobs();
                    });
                    return;
                case "EqLow":
                    InvokeAsync(() => {
                        targetPlayer.EqControls.ApplyEqLow(value);
                        targetPlayer.EqControls.UpdateKnobs();
                    });
                    return;
                case "Color":
                    targetPlayer.FilterControls.FiltersValues.Color = value;
                    InvokeAsync(targetPlayer.FilterControls.UpdateKnobs);
                    return;
                case "JogWheelForward":
                    if(mapping.Velocity == ((midiEvent.param >> 8) & 0xFF)) targetPlayer.JogWheelForward();
                    return;
                case "JogWheelBackward":
                    if(mapping.Velocity == ((midiEvent.param >> 8) & 0xFF)) targetPlayer.JogWheelBackward();
                    return;

                // The two below are deliberately the only cases here that do not go through
                // InvokeAsync. Everything else is a UI action and belongs on the renderer; a
                // platter is a control path, and the whole point of taking it off the renderer is
                // that it does not queue behind a render. They run on the MIDI callback thread.
                case "JogTouch":
                    targetPlayer.JogTouchChanged(velocity > 0);
                    return;
                case "JogWheel":
                    // An absolute mapping here would be a mis-learn rather than a valid setup: a
                    // platter has no position to report, so a value read as one is meaningless.
                    if(mapping.Mode != MidiControllerProfile.MappingModes.Relative) return;

                    targetPlayer.ScratchByTicks(
                        MidiControllerProfile.DecodeRelative(MidiValue(midiEvent), mapping.RelativeFormat),
                        mapping.TicksPerRevolution);
                    return;
                case "JogBend":
                    if(mapping.Mode != MidiControllerProfile.MappingModes.Relative) return;

                    targetPlayer.JogBendByTicks(
                        MidiControllerProfile.DecodeRelative(MidiValue(midiEvent), mapping.RelativeFormat),
                        mapping.TicksPerRevolution);
                    return;
                case "Tempo":
                    double tempo = 1.0 - value;
                    InvokeAsync(() => targetPlayer.SetTempo(tempo));
                    return;
                case "BpmMatch": {
                    InvokeAsync(targetPlayer.SyncBPMToOtherPlayer);
                    return;
                }
            }
        }

        if(section == "keyboard") {
            double pitch = 0;

            switch(propertyName) {
                case "Volume":
                    if(player1 == null) return;

                    double volume = midiEvent.param / 127.0;
                    InvokeAsync(() => player1.SetTrackVolume(volume));
                    return;
                case "Pitch":
                    if(player1 == null) return;

                    pitch = (midiEvent.param - 8192) / 8192.0 * 12.0; // +/- 12 semitones
                    player1.SetPitch(pitch);
                    player1.FilterControls.FiltersValues.Key = pitch / 12.0 + 0.5;
                    InvokeAsync(player1.FilterControls.UpdateKnobs);
                    shouldRender = true;
                    InvokeAsync(StateHasChanged);
                    return;
                default:
                    // FirstKey and LastKey mark the ends of the playable range rather than two
                    // separate actions, but MidiTools matches a note against both of them, so one
                    // key press lands here twice. Acting on both played, pitched and stopped the
                    // deck twice per press and pushed the key onto midiPressedKeys twice. Both
                    // dispatches still happen - the settings dialog needs them to learn either
                    // end of the range - so drop one of them here, where the action lives.
                    if(propertyName != nameof(MidiControllerProfile.KeyboardMapping.FirstKey)) return;

                    if(midiEvent.eventtype == BASSMIDIEvent.MIDI_EVENT_NOTE) {
                        if(player1 == null || player1.File == null) return;

                        int keyNumber = midiEvent.param & 0xFF;
                        int keyVelocity = (midiEvent.eventtype == BASSMIDIEvent.MIDI_EVENT_NOTE) ? (midiEvent.param >> 8) & 0xFF : -1;

                        if(keyVelocity > 0) {
                            string key = midiKeyTools.FromMidiNote(keyNumber, KeyTools.Notations.American, true);
                            double trackKeyNumber = midiKeyTools.ToMidiNote(player1.File.Key ?? key);
                            pitch = keyNumber - trackKeyNumber;

                            if(player1.IsPlaying) player1.Stop(true); // Force no polyphony

                            player1.SetPitch(pitch);
                            player1.FilterControls.FiltersValues.Key = pitch / 12.0 + 0.5;
                            player1.Play(false);

                            midiPressedKeys.Add(keyNumber);
                        } else {
                            int lastIndex = midiPressedKeys.LastIndexOf(keyNumber);
                            if(lastIndex >= 0) midiPressedKeys.RemoveAt(lastIndex);
                            if(midiPressedKeys.Count == 0) {
                                player1.FilterControls.FiltersValues.Key = 0.5;
                                player1.Stop(true);
                            }
                        }

                        // FIXME: This looks like will cause way too many re-renders
                        InvokeAsync(player1.FilterControls.UpdateKnobs);
                        shouldRender = true;
                        InvokeAsync(StateHasChanged);
                    }
                    return;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender) {
            SetMediaProviders();

            await Task.Delay(500);

            string? folder = session.Get<string>(nameof(selectedFolder));
            if(folder != null && folder != "") {
                SelectedFolderChanged(folder);
                await InvokeAsync(StateHasChanged);
            }

            DFile? file = session.Get<DFile>(nameof(selectedFile));
            if(file != null) filesComponent?.ChangeSelectedFile(file);

            while(true) {
                await Task.Delay(250);

                if(player1 != null && player2 != null) {
                    monitorVolume?.SetInitialValue(0.5);
                    ApplyMonitorVolume(0.5);
                    ApplyMonitorMix(0.5);
                    ApplyMainGain(0.5);

                    break;
                }
            }

            // TODO: Not sure what to do with this yet... maybe implement a theme editor?
